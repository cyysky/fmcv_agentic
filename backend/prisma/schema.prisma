generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Connection {
  id                   String   @id @default(uuid())
  displayName          String
  baseUrl              String
  modelName            String
  contextLength        Int
  concurrentConnections Int     @default(10)
  apiKey               String?
  defaultParameters    Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("connections")
}

model Channel {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  projectName String
  parentId    String?
  agentName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Channel?  @relation("ChannelChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Channel[] @relation("ChannelChildren")

  members  ChannelMember[]
  messages ChannelMessage[]

  @@index([parentId])
  @@map("channels")
}

model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  agentName String
  addedAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, agentName])
  @@map("channel_members")
}

model ChannelMessage {
  id        String   @id @default(uuid())
  channelId String
  role      String // user | agent | system
  author    String
  text      String
  toolCalls Json?
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("channel_messages")
}
