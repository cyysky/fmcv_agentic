generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Connection {
  id                   String   @id @default(uuid())
  displayName          String
  baseUrl              String
  modelName            String
  contextLength        Int
  concurrentConnections Int     @default(10)
  apiKey               String?
  defaultParameters    Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("connections")
}
