generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Connection {
  id                   String   @id @default(uuid())
  displayName          String
  baseUrl              String
  modelName            String
  contextLength        Int
  concurrentConnections Int     @default(10)
  apiKey               String?
  defaultParameters    Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("connections")
}

model Channel {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  projectName String
  parentId    String?
  agentName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Channel?  @relation("ChannelChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Channel[] @relation("ChannelChildren")

  members  ChannelMember[]
  messages ChannelMessage[]
  runs     ChannelRun[]

  @@index([parentId])
  @@map("channels")
}

model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  agentName String
  addedAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, agentName])
  @@map("channel_members")
}

model ChannelMessage {
  id        String   @id @default(uuid())
  channelId String
  role      String // user | agent | system
  author    String
  text      String
  toolCalls Json?
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("channel_messages")
}

/**
 * Persisted history of streaming channel jobs (ChannelJobService). The live
 * event stream runs in memory; the row is written on create and updated with
 * its terminal snapshot so statuses/debug traces survive backend restarts.
 * Rows are cascade-deleted with their channel.
 */
model ChannelRun {
  id         String    @id
  channelId  String
  agentName  String
  status     String // running | done | error | stopped
  events     Json      @default("[]")
  answer     String?
  steps      Int?
  error      String?
  maxSteps   Int?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, agentName, createdAt])
  @@map("channel_runs")
}

/**
 * Persisted agent chat sessions (BaseAgentService). Messages are stored as
 * JSON; the row is written on create and every conversation turn, so chat
 * history survives backend restarts. Mirrors the ChannelRun restart pattern.
 */
model AgentSession {
  id        String    @id
  title     String
  model     String
  messages  Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("agent_sessions")
}
