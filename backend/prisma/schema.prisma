generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Connection {
  id                   String   @id @default(uuid())
  displayName          String
  baseUrl              String
  modelName            String
  contextLength        Int
  concurrentConnections Int     @default(10)
  apiKey               String?
  defaultParameters    Json?
  models               String[] @default([])
  lastProbeAt          DateTime?
  lastProbeOk          Boolean?
  lastProbeStatus      Int?
  lastProbeLatencyMs   Int?
  lastProbeModel       String?
  lastProbeMessage     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  agentSessions AgentSession[]
  cronJobs      CronJob[]

  @@map("connections")
}

model Channel {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  projectName String
  parentId    String?
  agentName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Channel?  @relation("ChannelChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Channel[] @relation("ChannelChildren")

  members  ChannelMember[]
  messages ChannelMessage[]
  runs     ChannelRun[]

  @@index([parentId])
  @@map("channels")
}

model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  agentName String
  addedAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, agentName])
  @@map("channel_members")
}

model ChannelMessage {
  id        String   @id @default(uuid())
  channelId String
  role      String // user | agent | system
  author    String
  text      String
  toolCalls Json?
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("channel_messages")
}

/**
 * Persisted history of streaming channel jobs (ChannelJobService). The live
 * event stream runs in memory; the row is written on create and updated with
 * its terminal snapshot so statuses/debug traces survive backend restarts.
 * Rows are cascade-deleted with their channel.
 */
model ChannelRun {
  id         String    @id
  channelId  String
  agentName  String
  status     String // running | done | error | stopped
  events     Json      @default("[]")
  answer     String?
  steps      Int?
  error      String?
  maxSteps   Int?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, agentName, createdAt])
  @@map("channel_runs")
}

/**
 * Persisted agent chat sessions (BaseAgentService). Messages are stored as
 * JSON; the row is written on create and every conversation turn, so chat
 * history survives backend restarts. Mirrors the ChannelRun restart pattern.
 */
model AgentSession {
  id           String    @id
  title        String
  model        String
  messages     Json
  connectionId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@map("agent_sessions")
}

/**
 * Managed document bucket (DIRECTION.md item 1). A bucket is a uniquely
 * named, read-only container mapped to either a project folder or an agent
 * folder; a project/agent folder can carry many buckets. Bucket metadata is
 * immutable after creation (no update or delete endpoints), and documents
 * inside a bucket can be added/read but never edited or overwritten.
 */
model Bucket {
  id         String   @id @default(uuid())
  name       String   @unique
  folderType String // "project" | "agent"
  folderName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  documents ManagedDocument[]

  @@map("buckets")
}

/**
 * A managed document inside a Bucket. Physical content is written once to
 * <mapped folder>/<bucket name>/<sanitized file name> and never overwritten;
 * the unique [bucketId, name] pair (plus `wx` file creation) enforces that.
 */
model ManagedDocument {
  id        String   @id @default(uuid())
  bucketId  String
  name      String
  kind      String // "pdf" | "text" | "video" | "audio" | "other"
  mimeType  String?
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())

  bucket Bucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@unique([bucketId, name])
  @@index([bucketId])
  @@map("managed_documents")
}

/**
 * A scheduled cron job (DIRECTION.md item 2). Each job runs a recurring
 * agent-turn task on a 5-field cron schedule (minute hour day-of-month
 * month day-of-week). `nextRunAt` is the scheduler's next due time (null
 * while disabled); `lastRun*` records the most recent execution and result.
 */
model CronJob {
  id             String    @id @default(uuid())
  name           String    @unique
  schedule       String
  taskType       String    @default("agent-turn")
  prompt         String
  model          String?
  connectionId   String?
  maxSteps       Int?
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  lastRunStatus  String? // "running" | "done" | "error"
  lastRunMessage String?
  lastRunModel   String?
  lastRunMs      Int?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  runs       CronRun[]

  @@index([connectionId])
  @@map("cron_jobs")
}

/**
 * Distributed scheduler lease (Round 65, refined Round 66).
 *
 * One row per scheduler group backs the cron scheduler election: each
 * backend replica periodically claims/renews the lease in one atomic
 * statement, and only the replica that holds a fresh lease runs the ticker.
 * If the holder dies without renewing, the lease expires (expireAt) and the
 * next replica's claim succeeds — so scheduling no longer depends on a
 * single NestJS instance. Job firing is additionally guarded by an atomic
 * row claim on CronJob.lastRunStatus, so even a split-brain lease can never
 * run the same due job twice. The row id is the group itself (the PK), so
 * separate CRON_LEASE_GROUP deployments elect independently.
 */
model CronSchedulerLease {
  id             String   @id
  schedulerGroup String   @default("default")
  owner          String
  expireAt       DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schedulerGroup])
  @@map("cron_scheduler_leases")
}

/** One terminal execution of a cron job (Round 67): append-only history so
 *  every firing is auditable even as `CronJob.lastRun*` rolls forward. */
model CronRun {
  id        String   @id @default(cuid())
  cronJobId String
  cronJob   CronJob  @relation(fields: [cronJobId], references: [id], onDelete: Cascade)
  status    String // "done" | "error"
  message   String?
  model     String?
  ms        Int?
  startedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([cronJobId, createdAt])
  @@map("cron_runs")
}

/**
 * An agent skill (DIRECTION.md item 3). A skill is a named, uniquely
 * identified capability: a description plus markdown instructions (the skill
 * body, e.g. a SKILL.md) that agents can load and follow. Skills are
 * authored here, marked `installed` when ready for use, and surfaced to
 * agent turns through the `read_skill` tool + a system-prompt registry
 * block. Uninstalling keeps the authored record; deleting removes it.
 */
model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  content     String   @default("")
  installed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("skills")
}
